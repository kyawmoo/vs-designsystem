{
  "$description": "VectorSticker Design System — canonical design tokens. Source of truth for vectorsticker.com (Laravel/Blade) and reports.vectorsticker.com (React). Values audited from the live vectorsticker.com codebase, established as the brand standard on 23 Sep 2026.",

  "color": {
    "brand": {
      "primary": { "value": "#4CAF50", "description": "Core brand green — primary buttons, links, active states, verified/approved indicators" },
      "accent": { "value": "#BCFD1D", "description": "Electric lime accent — highlight tags, promotional badges, selection indicators. Used sparingly." },
      "secondary": { "value": "#222222", "description": "Dark surface — secondary buttons, sidebars, footers, nav bars" }
    },
    "neutral": {
      "background": { "value": "#F8F8F8", "description": "Default page canvas background" },
      "surface": { "value": "#FFFFFF", "description": "Card/container/form-field background" },
      "border": { "value": "#ECECEC", "description": "Default border color" },
      "text-heading": { "value": "#010D4C", "description": "Heading text — deep navy" },
      "text-body": { "value": "#2B2B2B", "description": "Primary body text" },
      "text-muted": { "value": "#8E9CBA", "description": "Muted/secondary/placeholder text" },
      "disabled-bg": { "value": "#EEEEEE", "description": "Disabled form field background" }
    },
    "status": {
      "success-bg": { "value": "#E0F9E0" },
      "success-border": { "value": "#55B355" },
      "danger-bg": { "value": "#FFDCDC" },
      "danger-border": { "value": "#C13B3B" },
      "warning-bg": { "value": "#FFF7DC" },
      "warning-border": { "value": "#FFD854" },
      "info-bg": { "value": "#E0E1F9" },
      "info-border": { "value": "#5558B3" }
    },
    "badge": {
      "trending": { "value": "#0074E4", "description": "Trending item badge" },
      "sale": { "value": "#0BBE9A", "description": "On-sale item badge" },
      "free": { "value": "#743CEE", "description": "Free item badge" },
      "premium": { "value": "#4CAF50", "description": "Premium item badge — aliases brand.primary" }
    },
    "item-status": {
      "pending": { "value": "#FF7A14", "description": "Item awaiting moderation" },
      "soft-rejected": { "value": "#5506E8", "description": "Item rejected, resubmission allowed" },
      "resubmitted": { "value": "#0A89FF", "description": "Item resubmitted after soft rejection" },
      "approved": { "value": "#00BA10", "description": "Item approved/live" },
      "hard-rejected": { "value": "#D60C0C", "description": "Item permanently rejected" },
      "deleted": { "value": "#F44336", "description": "Item deleted/removed" }
    }
  },

  "typography": {
    "font-family": { "value": "Roboto, sans-serif", "description": "Unified font — replaces Montserrat (public) and reports.vectorsticker.com's Inter" },
    "scale": {
      "body-sm": { "fontSize": "13px", "fontWeight": "400", "description": "Base body text" },
      "body-md": { "fontSize": "16px", "fontWeight": "400", "description": "Card/item titles, section body text" },
      "heading-sm": { "fontSize": "15px", "fontWeight": "600", "description": "Smallest heading" },
      "heading-md": { "fontSize": "28px", "fontWeight": "600", "description": "Section titles" },
      "display": { "fontSize": "45px", "fontWeight": "600", "description": "Pricing display, large stat numbers" }
    },
    "line-height": {
      "body": { "value": "1.7", "description": "Relaxed line-height for descriptive paragraphs" }
    }
  },

  "radius": {
    "xs": { "value": "5px", "description": "Dividers, small accents, pagination items" },
    "sm": { "value": "8px", "description": "Default — buttons, form inputs, cards. Most common." },
    "lg": { "value": "12px", "description": "Larger feature cards" },
    "xl": { "value": "20px", "description": "Hero/banner elements" },
    "full": { "value": "9999px", "description": "Pills, badges, avatars, circular elements" }
  },

  "shadow": {
    "principle": "Flat design — no box-shadow anywhere. Elevation comes only from 1px borders and background-color contrast.",
    "none": { "value": "none" }
  },

  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "section-compact": { "value": "30px", "description": "Compact section vertical padding" },
    "section-default": { "value": "60px", "description": "Standard section vertical padding" }
  }
