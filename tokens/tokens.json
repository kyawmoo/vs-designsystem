{
  "$description": "VectorSticker Design System — canonical design tokens. Source of truth for vectorsticker.com (Laravel/Blade) and reports.vectorsticker.com (React). Values audited from the live vectorsticker.com codebase, established as the brand standard on 23 Sep 2026.",

  "color": {
    "brand": {
      "primary": { "value": "#4CAF50", "description": "Core brand green — primary buttons, links, active states, verified/approved indicators" },
      "accent": { "value": "#BCFD1D", "description": "Electric lime accent — highlight tags, promotional badges, selection indicators. Used sparingly." },
      "secondary": { "value": "#222222", "description": "Dark surface — secondary buttons, sidebars, footers, nav bars" }
    },
    "neutral": {
      "background": { "value": "#F8F8F8", "description": "Default page canvas background" },
      "surface": { "value": "#FFFFFF", "description": "Card/container/form-field background" },
      "border": { "value": "#ECECEC", "description": "Default border color" },
      "text-heading": { "value": "#010D4C", "description": "Heading text — deep navy" },
      "text-body": { "value": "#2B2B2B", "description": "Primary body text" },
      "text-muted": { "value": "#8E9CBA", "description": "Muted/secondary/placeholder text" },
      "disabled-bg": { "value": "#EEEEEE", "description": "Disabled form field background" }
    },
    "status": {
      "success-bg": { "value": "#E0F9E0" },
      "success-border": { "value": "#55B355" },
      "danger-bg": { "value": "#FFDCDC" },
      "danger-border": { "value": "#C13B3B" },
      "warning-bg": { "value": "#FFF7DC" },
      "warning-border": { "value": "#FFD854" },
      "info-bg": { "value": "#E0E1F9" },
      "info-border": { "value": "#5558B3" }
    },
    "badge": {
      "trending": { "value": "#0074E4", "description": "Trending item badge" },
      "sale": { "value": "#0BBE9A", "description": "On-sale item badge" },
      "free": { "value": "#743CEE", "description": "Free item badge" },
      "premium": { "value": "#4CAF50", "description": "Premium item badge — aliases brand.primary" }
    },
    "item-status": {
      "pending": { "value": "#FF7A14", "description": "Item awaiting moderation" },
      "soft-rejected": { "value": "#5506E8", "description": "Item rejected, resubmission allowed" },
      "resubmitted": { "value": "#0A89FF", "description": "Item resubmitted after soft rejection" },
      "approved": { "value": "#00BA10", "description": "Item approved/live" },
      "hard-rejected": { "value": "#D60C0C", "description": "Item permanently rejected" },
      "deleted": { "value": "#F44336", "description": "Item deleted/removed" }
    }
  },

  "typography": {
    "font-family": { "value": "Roboto, sans-serif", "description": "Unified font — replaces Montserrat (public) and reports.vectorsticker.com's Inter" },
    "scale": {
      "body-sm": { "fontSize": "13px", "fontWeight": "400", "description": "Base body text" },
      "body-md": { "fontSize": "16px", "fontWeight": "400", "description": "Card/item titles, section body text" },
      "heading-sm": { "fontSize": "15px", "fontWeight": "600", "description": "Smallest heading" },
      "heading-md": { "fontSize": "28px", "fontWeight": "600", "description": "Section titles" },
      "display": { "fontSize": "45px", "fontWeight": "600", "description": "Pricing display, large stat numbers" }
    },
    "type-scale": {
      "$description": "Full hierarchy added 25 Sep 2026 (Typography spec v2). The 'scale' block above is kept for existing components; display-01 = display, body-01 = body-sm.",
      "display-01": { "fontSize": "45px", "lineHeight": "52px", "fontWeight": "600", "description": "Hero pricing, stat numbers, banner displays" },
      "heading-01": { "fontSize": "36px", "lineHeight": "44px", "fontWeight": "700", "description": "Primary page title, hero header (H1)" },
      "heading-02": { "fontSize": "30px", "lineHeight": "38px", "fontWeight": "600", "description": "Major category sections, feature areas (H2)" },
      "heading-03": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": "600", "description": "Section titles, modal dialog headings (H3)" },
      "heading-04": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": "600", "description": "Card group headings, widget headers (H4)" },
      "body-02": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": "500", "description": "Lead body copy, navigation links, prominent items" },
      "paragraph": { "fontSize": "15px", "lineHeight": "24px", "fontWeight": "400", "description": "Long-form body, article copy, documentation content" },
      "body-01": { "fontSize": "13px", "lineHeight": "20px", "fontWeight": "400", "description": "Compact UI body text, lists, secondary descriptions" },
      "label": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": "600", "textTransform": "uppercase", "description": "Form labels, button badges, category metadata tags" },
      "caption": { "fontSize": "11px", "lineHeight": "15px", "fontWeight": "400", "description": "Field hint captions, timestamps, legal microcopy" }
    },
    "weight": {
      "title": { "value": "600", "description": "Titles" },
      "card-title": { "value": "500", "description": "Card/item titles" },
      "body": { "value": "400", "description": "Body text" }
    },
    "line-height": {
      "body": { "value": "1.7", "description": "Relaxed line-height for descriptive paragraphs" }
    }
  },

  "radius": {
    "xs": { "value": "5px", "description": "Dividers, small accents, pagination items" },
    "sm": { "value": "8px", "description": "Default — form inputs, cards; icon-only buttons. Most common. (Text buttons use button.radius — see Button spec v2.)" },
    "lg": { "value": "12px", "description": "Larger feature cards" },
    "xl": { "value": "20px", "description": "Hero/banner elements" },
    "full": { "value": "9999px", "description": "Pills, badges, avatars, circular elements" }
  },

  "button": {
    "$description": "Button spec v2 (25 Sep 2026). Used by react/src/components/Button.tsx. Blade (vectorsticker.com) still renders the site's own .btn styles until that site's CSS is updated.",
    "primary": { "default": { "value": "#4CAF50" }, "hover": { "value": "#43A047" }, "pressed": { "value": "#388E3C" } },
    "secondary": { "default": { "value": "#222222" }, "hover": { "value": "#333333" }, "pressed": { "value": "#151515" } },
    "tertiary": { "border": { "value": "#D1D5DB" }, "text": { "value": "#18181B" }, "hover-bg": { "value": "rgba(76, 175, 80, 0.10)" }, "pressed-bg": { "value": "rgba(76, 175, 80, 0.20)" }, "active-border": { "value": "#4CAF50" } },
    "cta-support": { "default": { "value": "#F59E0B" }, "hover": { "value": "#F5A623" }, "pressed": { "value": "#D97706" }, "text": { "value": "#18181B" } },
    "height": { "sm": { "value": "32px" }, "md": { "value": "40px" }, "lg": { "value": "48px" } },
    "padding-x": { "sm": { "value": "16px" }, "md": { "value": "28px" }, "lg": { "value": "32px" } },
    "font-size": { "sm": { "value": "13px" }, "md": { "value": "14px" }, "lg": { "value": "16px" } },
    "font-weight": { "value": "500" },
    "icon-only-size": { "sm": { "value": "32px" }, "md": { "value": "38px" }, "lg": { "value": "44px" } },
    "social-size": { "value": "40px" },
    "radius": {
      "text": { "value": "4px", "description": "Primary / secondary text buttons" },
      "soft": { "value": "6px", "description": "Tertiary, icon + text, OAuth buttons" },
      "icon": { "value": "8px", "description": "Icon-only buttons" },
      "social": { "value": "5px", "description": "Social share swatches" },
      "cta": { "value": "12px", "description": "Support / sponsor CTA pill" }
    },
    "disabled-opacity": { "value": "0.5" },
    "pressed-scale": { "value": "0.98" }
  },

  "card": {
    "$description": "Card spec v2 (25 Sep 2026). Item card + generic content card. Used by react/src/components/Card.tsx; vectorsticker.com's live .item card still uses 8px radius until that site's CSS is updated.",
    "radius": { "value": "3px", "description": "Card, card image and badge corners" },
    "border": { "value": "#E5E7EB", "description": "1px card border" },
    "divider": { "value": "#F3F4F6", "description": "Footer divider and image frame" },
    "media-bg": { "value": "#F9FAFB", "description": "Image backdrop, 1:1 ratio" },
    "padding-item": { "value": "14px", "description": "Item card inner padding" },
    "padding-content": { "value": "45px", "description": "Generic content card padding (24px below 768px)" },
    "badge-inset": { "value": "10px", "description": "Badge offset from the image's top-left corner" },
    "title": { "fontSize": "16px", "fontWeight": "500", "description": "1 line, ellipsis" },
    "price": { "fontSize": "18px", "fontWeight": "700", "color": "#111827" },
    "price-old": { "fontSize": "14px", "color": "#9CA3AF", "description": "Strikethrough regular price" },
    "price-sale": { "color": "#4CAF50" },
    "hover-border": { "value": "#4CAF50" },
    "hover-lift": { "value": "-4px", "description": "translateY on hover" },
    "badge-priority": { "value": "premium > free > sale > trending", "description": "One badge per card — same order as partials/item.blade.php" }
  },

  "icon": {
    "principle": "Icon LIBRARY intentionally differs by platform: reports.vectorsticker.com (React) uses lucide-react SVG components; vectorsticker.com (Blade) uses Font Awesome icon-font classes, already deeply embedded site-wide. Re-unifying the library was judged not worth the rework risk on the main site. What IS shared is the SIZE SCALE below, so icons carry the same visual weight on both platforms.",
    "scale": {
      "sm": { "value": "16px", "description": "Inline with body text, dense UI (filter icons, table row actions)" },
      "md": { "value": "20px", "description": "Default — buttons, headers, nav items" },
      "lg": { "value": "24px", "description": "Standalone/featured icons" }
    },
    "stroke-width": { "value": "2", "description": "lucide-react only — Font Awesome has no stroke-width equivalent" }
  },

  "shadow": {
    "principle": "Flat design — no box-shadow anywhere. Elevation comes only from 1px borders and background-color contrast.",
    "none": { "value": "none" }
  },

  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "section-compact": { "value": "30px", "description": "Compact section vertical padding" },
    "section-default": { "value": "60px", "description": "Standard section vertical padding" }
  }
}
